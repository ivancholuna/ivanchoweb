      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "node-topics",
      "name": "Obtener T\u00f3picos Publicados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3007/api/blog/topics",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "{N8N_INTERNAL_API_KEY}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-gen-es",
      "name": "Claude: Generar ES",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "{ANTHROPIC_API_KEY}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  model: 'claude-sonnet-4-6',\n  max_tokens: 4000,\n  system: 'Eres el asistente de contenido de IVANCHOWEB (ivanchoweb.com), el portafolio de Ivan Luna, desarrollador full-stack freelancer. Ivan construy\u00f3: DentalPro (SaaS odontol\u00f3gico), LegalPro (SaaS legal), ContaPro (SaaS contable), StoreFlow (SaaS e-commerce). Stack: Node.js, React, PostgreSQL, n8n, WordPress/Divi, Claude API. Sirve clientes US en Upwork. REGLAS: genera contenido \u00daNICO que NO repita los \u00e1ngulos ya publicados. Responde SOLO con JSON v\u00e1lido, sin markdown ni texto adicional.',\n  messages: [{\n    role: 'user',\n    content: '\u00c1ngulos ya publicados: ' + JSON.stringify($json.published?.map(p => p.titulo_en) ?? []) + '\\n\\nGenera un art\u00edculo de blog EN ESPA\u00d1OL para ivanchoweb.com con un \u00e1ngulo nuevo. Pilares disponibles: caso de estudio DentalPro, caso de estudio LegalPro, freelancing en Upwork como desarrollador LATAM, costos reales de un SaaS en producci\u00f3n, c\u00f3mo n8n reemplaza Zapier, IA en negocios latinoamericanos, WordPress vs SaaS cu\u00e1ndo elegir cada uno, automatizaci\u00f3n de leads con n8n.\\n\\nResponde SOLO con este JSON (sin markdown):\\n{\\n  \"slug\": \"slug-en-ingles-del-articulo\",\\n  \"pilar_tematico\": \"nombre del pilar\",\\n  \"tag_en\": \"Tag en ingl\u00e9s (ej: Case Study)\",\\n  \"tag_es\": \"Tag en espa\u00f1ol (ej: Caso de Estudio)\",\\n  \"tag_color\": \"uno de: indigo, teal, orange, red, green\",\\n  \"read_time_mins\": 9,\\n  \"titulo_es\": \"T\u00edtulo en espa\u00f1ol\",\\n  \"meta_description_es\": \"Meta description en espa\u00f1ol, 150-160 caracteres\",\\n  \"cuerpo_es\": \"HTML completo del cuerpo del art\u00edculo en espa\u00f1ol. Incluye p\u00e1rrafo introductorio fuerte, 4-6 secciones H2, listas, blockquotes, conclusi\u00f3n. M\u00ednimo 1200 palabras. Solo etiquetas HTML: p, h2, h3, ul, li, strong, em, blockquote, code. NO incluir el H1 ni el CTA final (van autom\u00e1ticamente).\",\\n  \"titulo_en\": \"Title in English\",\\n  \"meta_description_en\": \"Meta description in English, 150-160 chars\",\\n  \"cuerpo_en\": \"Full HTML body in English. Same structure as cuerpo_es but adapted (not literal translation) for US audience tone. Minimum 1200 words.\"\n}'\n  }]\n}) }}",
        "options": {}
      }
    },
    {
      "id": "node-parse",
      "name": "Parsear Respuesta Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst text = raw.content?.[0]?.text || '';\n// Extraer JSON limpio\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('Claude no devolvi\u00f3 JSON v\u00e1lido: ' + text.substring(0, 200));\nconst post = JSON.parse(match[0]);\n// Validar campos m\u00ednimos\nif (!post.slug || !post.titulo_es || !post.titulo_en) {\n  throw new Error('Faltan campos requeridos en la respuesta de Claude');\n}\nreturn [{ json: post }];"
      }
    },
    {
      "id": "node-save-draft",
      "name": "Guardar Borrador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
