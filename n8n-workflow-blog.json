      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "951511379",
        "text": "=\ud83d\udcdd <b>Nuevo borrador de blog listo para revisi\u00f3n</b>\n\n\ud83c\udd94 Post ID: <b>{{ $('Guardar Borrador').first().json.id }}</b>\n\ud83d\udccc Pilar: {{ $('Parsear Respuesta Claude').first().json.pilar_tematico }}\n\n\ud83c\uddea\ud83c\uddf8 <b>ES:</b> {{ $('Parsear Respuesta Claude').first().json.titulo_es }}\n<i>{{ $('Parsear Respuesta Claude').first().json.meta_description_es }}</i>\n\n\ud83c\uddfa\ud83c\uddf8 <b>EN:</b> {{ $('Parsear Respuesta Claude').first().json.titulo_en }}\n<i>{{ $('Parsear Respuesta Claude').first().json.meta_description_en }}</i>\n\n\ud83d\udd17 Slug: /blog/{{ $('Parsear Respuesta Claude').first().json.slug }}/\n\n\u2705 Para aprobar:\nhttps://n8n.ivanchoweb.com/webhook/blog-aprobar?id={{ $('Guardar Borrador').first().json.id }}&token={N8N_INTERNAL_API_KEY}\n\n\u274c Para rechazar:\nhttps://n8n.ivanchoweb.com/webhook/blog-rechazar?id={{ $('Guardar Borrador').first().json.id }}&token={N8N_INTERNAL_API_KEY}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "902b9894-0d8d-4dc1-a4ab-30104da7e944",
          "name": "Telegram IVANCHOWEB"
        }
